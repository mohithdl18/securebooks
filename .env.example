# Copy to .env.local (never commit real values)

MONGODB_URI=mongodb+srv://<least-privilege-user>:<password>@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=suvilla_bookings

# Razorpay — use rzp_test_ keys locally, rzp_live_ only in production env vars
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set in Razorpay Dashboard → Webhooks. Must differ from the key secret.
RAZORPAY_WEBHOOK_SECRET=generate-a-long-random-string

# Your public site origin(s), comma separated. Used to block cross-site requests.
APP_ORIGIN=https://book.suvilla.in

# Bearer secrets for maintenance endpoints (openssl rand -hex 32)
CRON_SECRET=
HEALTHCHECK_SECRET=

# Set to "false" to hold conflicting payments for manual refund instead of auto-refunding
AUTO_REFUND_ON_CONFLICT=true

# Admin dashboard (/admin) — password 10+ characters, PIN 4–8 digits
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_CANCEL_PIN=000000

# Booking confirmation emails (Resend) — see RESEND_SETUP.md
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="SU VILLA by the Creek <bookings@mail.suvilla.in>"
EMAIL_REPLY_TO=suvilla.reservations@gmail.com
# Optional: copy every confirmation to the resort (comma-separated)
EMAIL_BCC=
